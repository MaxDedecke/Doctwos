# Copy to .env and fill in real values before `docker compose up`.

# Tags the custom-built images (doctus-backend-api/doctus-parser-worker/doctus-frontend).
# Keep this in sync with the version baked into an offline bundle (see
# scripts/build-offline-bundle.sh) — both paths must produce/expect the same tag.
DOCTUS_VERSION=latest

# Which compose files `docker compose` layers together (colon-separated, see
# https://docs.docker.com/compose/how-tos/multiple-compose-files/merge/).
# install.sh / install-offline.sh set this automatically: the base file
# (docker-compose.yml or docker-compose.offline.yml) alone on a CPU-only/dev
# host, plus docker-compose.gpu.yml appended when a working NVIDIA GPU +
# Container Toolkit are detected (GPU passthrough for the ollama service — see
# docs/DEPLOYMENT.md, "GPU passthrough (Ollama)"). Leave empty for a plain
# CPU-only/dev host; the installers fill this in, you normally don't set it
# by hand.
COMPOSE_FILE=

# Local LLM used for chat and the Code Compliance Checker (Ollama). Disabled
# until the first delivery so the current 4-vCPU/8GB CPU-only pilot host only
# loads bge-m3 for embeddings. Chat and LLM-based compliance remain unavailable
# in this mode.
#
# Working on a CPU-only/dev machine (no GPU) and just need chat/compliance to
# respond for testing? Don't set this — use a cloud LLM profile instead: set
# ALLOW_CLOUD_LLM=true below, then add an OpenAI/Gemini/Anthropic profile with
# your API key under Settings > AI in the running app. That's a per-browser,
# opt-in override (see CLAUDE.md's "Cloud nur als Opt-in") and needs no local
# model or GPU at all.
#
# On a GPU delivery host, set the validated model explicitly instead:
#   LLM_MODEL=hf.co/bartowski/Mistral-Nemo-Instruct-2407-GGUF:Q4_K_M
# On 24GB+ VRAM hardware, the Q8_0 build measurably lowers the compliance-
# checker's false-negative rate (see docs/COMPLIANCE_EVAL.md Befund 9/18/19/24):
#   LLM_MODEL=hf.co/bartowski/Mistral-Nemo-Instruct-2407-GGUF:Q8_0
# install.sh / scripts/build-offline-bundle.sh both read this to decide which
# tag to pull, so set it before running either — changing it afterwards means
# re-pulling the new tag yourself and updating this value to match. Also make
# sure GPU passthrough is actually wired (COMPOSE_FILE above) — without it,
# Ollama runs this model CPU-only regardless of the GPU sitting in the box.
LLM_MODEL=disabled

# Timeout (seconds) per LLM call in the Code Compliance Checker. Default 180.
# A 12B model on a CPU-only host (no GPU) can need well over the 60s used
# elsewhere for a single element verdict — at 60s those calls time out and are
# silently counted as llm_errors (the element gets no verdict). Raise further on
# very small CPU hosts; on GPU hosts the higher value costs nothing.
COMPLIANCE_LLM_TIMEOUT=

POSTGRES_DB=doctus
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Public URL the frontend container uses to reach the backend (read server-side
# at request time, see frontend/app/layout.tsx) — set this to your server's
# reachable address, e.g. http://your-server-ip:8000 or https://api.example.com.
API_URL=http://localhost:8000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32
SESSION_SECRET_KEY=

# Erststart-Superuser (F-001). Bleibt das Passwort leer, wird eines generiert
# und EINMALIG ins Startlog des Backends geschrieben.
BOOTSTRAP_SUPERUSER=admin
BOOTSTRAP_SUPERUSER_PASSWORD=
BOOTSTRAP_SUPERUSER_EMAIL=

FRONTEND_URL=http://localhost:3000

# Backend log verbosity (DEBUG/INFO/WARNING/ERROR). Parser worker verbosity is set
# separately via --loglevel on the celery command in parser/Dockerfile.
LOG_LEVEL=INFO

# Ordner-Wissensquelle: Absoluter Pfad auf dem Host-System, der in die Container
# als /watched (read-only) gemountet wird. Leer lassen wenn nicht benötigt.
# Beispiel: WATCHED_FOLDER=/mnt/nas/Wissensbasis
WATCHED_FOLDER=

# Cloud-LLMs lokal für Development freischalten (True/False)
ALLOW_CLOUD_LLM=
