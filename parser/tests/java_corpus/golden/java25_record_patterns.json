    {
      "content": "    static double width(Object value) {\n        if (value instanceof Line(final var start, Point end)) {\n            return end.x() - start.x();\n        }\n        switch (value) {\n            case Box(var content, _):\n                return content.hashCode();\n            default:\n                return 0;\n        }\n    }",
